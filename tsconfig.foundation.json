{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "build",
    "noEmitOnError": true
  },
  "include": [
    "contracts/src/**/*.ts",
    "sdk/typescript/src/**/*.ts",
    "core/src/**/*.ts",
    "modules/mock/src/**/*.ts",
    "providers/mock/src/**/*.ts",
    "providers/chat/openai-compatible/src/**/*.ts",
    "providers/chat/gemini/src/**/*.ts",
    "providers/chat/ollama/src/**/*.ts",
    "providers/embeddings/openai-compatible/src/**/*.ts",
    "host/ipc/src/**/*.ts",
    "host/credentials/src/**/*.ts",
    "runtime/bootstrap/src/**/*.ts",
    "tests/**/*.ts",
    "host/config/src/**/*.ts",
    "host/characters/src/**/*.ts",
    "host/core-book/src/**/*.ts",
    "host/memory/src/**/*.ts",
    "host/conversations/src/**/*.ts",
    "host/model-profiles/src/**/*.ts",
    "host/credential-profiles/src/**/*.ts",
    "host/provider-presets/src/**/*.ts",
    "host/settings/src/**/*.ts",
    "host/retrieval/src/**/*.ts"
  ],
  "exclude": [
    "apps/desktop-ui",
    "apps/desktop-host"
  ]
}
