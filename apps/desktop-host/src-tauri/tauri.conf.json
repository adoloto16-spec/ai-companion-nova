{
  "$schema":"https://schema.tauri.app/config/2",
  "productName":"AI Companion Nova",
  "version":"0.1.0",
  "identifier":"com.nova.ai-companion",
  "build":{
    "beforeDevCommand":"pnpm --dir ../../desktop-ui dev",
    "beforeBuildCommand":"pnpm --dir ../../desktop-ui build",
    "frontendDist":"../../desktop-ui/dist"
  },
  "app":{
    "security":{
      "capabilities":["default"],
      "csp":{
        "default-src":"'self' asset: customprotocol:",
        "connect-src":"ipc: http://ipc.localhost",
        "img-src":"'self' asset: data: blob:",
        "style-src":"'self' 'unsafe-inline'",
        "script-src":"'self'"
      }
    },
    "windows":[{"label":"main","title":"AI Companion Nova","width":1100,"height":760}]
  },
  "bundle":{"active":false}
}
