{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Companion Nova",
  "version": "0.2.0",
  "identifier": "com.nova.ai-companion",
  "build": {
    "beforeDevCommand": "pnpm --dir apps/desktop-ui dev",
    "beforeBuildCommand": "pnpm --dir apps/desktop-ui build",
    "frontendDist": "../../desktop-ui/dist"
  },
  "app": {
    "security": {
      "capabilities": [
        "default"
      ],
      "csp": {
        "default-src": "'self' asset: customprotocol:",
        "connect-src": "ipc: http://ipc.localhost http: https: ws://127.0.0.1:3900 ws://localhost:3900 ws://[::1]:3900",
        "img-src": "'self' asset: data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "AI Companion Nova",
        "width": 1100,
        "height": 760
      },
      {
        "label": "avatar-overlay",
        "title": "Nova Avatar",
        "url": "avatar-overlay.html",
        "width": 380,
        "height": 620,
        "x": 80,
        "y": 120,
        "center": false,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "startMenuFolder": "AI Companion Nova"
      }
    }
  }
}
