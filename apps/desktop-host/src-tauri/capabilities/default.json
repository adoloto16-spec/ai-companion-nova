{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal desktop capability. No filesystem, shell, process or automation plugin permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "allow-get-host-diagnostics",
    "allow-set-runtime-diagnostics",
    "allow-get-runtime-diagnostics",
    "allow-save-credential",
    "allow-get-credential",
    "allow-delete-credential",
    "allow-credential-exists",
    "allow-get-provider-configuration",
    "allow-save-provider-configuration",
    "allow-delete-provider-configuration",
    "allow-get-characters",
    "allow-save-characters",
    "allow-get-core-book-entries",
    "allow-save-core-book-entries",
    "allow-get-memory-state",
    "allow-save-memory-state",
    "allow-get-memory-semantic-index",
    "allow-save-memory-semantic-index",
    "allow-supersede-memory",
    "allow-search-retrieval-index",
    "allow-rebuild-retrieval-index",
    "allow-rebuild-all-retrieval-index",
    "allow-upsert-retrieval-document",
    "allow-remove-retrieval-document",
    "allow-remove-retrieval-character",
    "allow-get-model-profile",
    "allow-save-model-profile",
    "allow-delete-model-profile",
    "allow-get-credential-profiles",
    "allow-save-credential-profiles",
    "allow-delete-credential-profile",
    "allow-get-provider-presets",
    "allow-save-provider-presets",
    "allow-delete-provider-preset",
    "allow-list-conversations",
    "allow-get-conversation",
    "allow-save-conversation",
    "allow-delete-conversation",
    "allow-set-active-conversation",
    "allow-get-active-conversation",
    "allow-clear-conversation",
    "allow-get-app-settings",
    "allow-save-app-settings"
  ]
}
