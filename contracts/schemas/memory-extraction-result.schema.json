{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-companion-nova.dev/memory-extraction-result/v1",
  "title": "AI Companion Nova Memory Extraction Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "apiVersion",
    "schemaVersion",
    "characterId",
    "conversationId",
    "memories"
  ],
  "properties": {
    "apiVersion": {
      "enum": [
        "1"
      ]
    },
    "schemaVersion": {
      "enum": [
        "1"
      ]
    },
    "characterId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "conversationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "memories": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "https://schemas.ai-companion-nova.dev/memory-candidate/v1"
      }
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
