{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.ai-companion-nova.dev/memory-judge-decision/v1",
  "title":"AI Companion Nova Memory Judge Decision v1",
  "type":"object",
  "additionalProperties":false,
  "required":["decisions"],
  "properties":{
    "decisions":{
      "type":"array",
      "maxItems":100,
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["candidateId","relation"],
        "properties":{
          "candidateId":{"type":"string","minLength":1,"maxLength":200},
          "relation":{"enum":["duplicate","new_supersedes_candidate","candidate_supersedes_new","distinct","uncertain"]}
        }
      }
    }
  }
}
